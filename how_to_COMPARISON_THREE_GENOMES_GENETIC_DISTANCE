#!/usr/bin/env python3
from __future__ import annotations
import math
from pathlib import Path
from typing import Dict, List, Tuple


WINDOW = 30000

BASE = Path("/home/MBEacherin/yeray/genomes_comparison")
VAR_DIR = BASE / "asm_compare" / "vars"
OUT_DIR = BASE / "genetic_distance" / "tables"

FILES = {
    "MED_vs_ATL": {
        "vcf": VAR_DIR / "MED_vs_ATL.var.txt",
        "fai": Path("/home/MBEacherin/yeray/genomes/GCA_023653815.1_GSC_CCare_1.0_genomic.fna.fai"),
    },
    "MED_vs_PAC": {
        "vcf": VAR_DIR / "MED_vs_PAC.var.txt",
        "fai": Path("/home/MBEacherin/yeray/genomes/GCA_023653815.1_GSC_CCare_1.0_genomic.fna.fai"),
    },
    "ATL_vs_PAC": {
        "vcf": VAR_DIR / "ATL_vs_PAC.var.txt",
        "fai": Path("/home/MBEacherin/yeray/genomes/GCA_965117115.1_CarCar_QM_v1.21.12_Sc_genomic.fna.fai"),
    },
}


def read_main_28_from_fai(fai_path: Path) -> List[Tuple[str, int]]:
    contigs: List[Tuple[str, int]] = []
    with fai_path.open() as fh:
        for i, line in enumerate(fh):
            if i >= 28:
                break
            fields = line.rstrip("\n").split("\t")
            contigs.append((fields[0], int(fields[1])))
    return contigs


def init_windows(contigs: List[Tuple[str, int]]) -> Dict[str, List[int]]:
    windows: Dict[str, List[int]] = {}
    for chrom, length in contigs:
        nwin = math.ceil(length / WINDOW)
        windows[chrom] = [0] * nwin
    return windows


def fill_windows(vcf_path: Path, windows: Dict[str, List[int]]) -> None:
    with vcf_path.open() as fh:
        for line in fh:
            if line.startswith("#"):
                continue
            fields = line.rstrip("\n").split("\t")
            if len(fields) < 2:
                continue
            chrom = fields[0]
            if chrom not in windows:
                continue
            try:
                pos = int(fields[1])
            except ValueError:
                continue
            idx = (pos - 1) // WINDOW
            if 0 <= idx < len(windows[chrom]):
                windows[chrom][idx] += 1


def write_table(
    comparison: str,
    contigs: List[Tuple[str, int]],
    windows: Dict[str, List[int]],
    out_path: Path,
) -> None:
    with out_path.open("w") as out:
        out.write(
            "\t".join(
                [
                    "comparison",
                    "chromosome",
                    "chrom_length",
                    "window_index",
                    "window_start",
                    "window_end",
                    "window_size",
                    "variant_count",
                    "genetic_distance",
                ]
            ) + "\n"
        )
        for chrom, chrom_len in contigs:
            for i, count in enumerate(windows[chrom], start=1):
                start = (i - 1) * WINDOW + 1
                end = min(i * WINDOW, chrom_len)
                size = end - start + 1
                gd = count / size
                out.write(
                    "\t".join(
                        [
                            comparison,
                            chrom,
                            str(chrom_len),
                            str(i),
                            str(start),
                            str(end),
                            str(size),
                            str(count),
                            f"{gd:.8f}",
                        ]
                    ) + "\n"
                )


def main() -> None:
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    for comparison, cfg in FILES.items():
        contigs = read_main_28_from_fai(cfg["fai"])
        windows = init_windows(contigs)
        fill_windows(cfg["vcf"], windows)
        out_path = OUT_DIR / f"{comparison}_30kb.tsv"
        write_table(comparison, contigs, windows, out_path)
        print(f"[OK] {comparison} -> {out_path}")


if __name__ == "__main__":
    main()
