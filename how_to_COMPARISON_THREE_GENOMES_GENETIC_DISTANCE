### 4) Detecting outliers + Rosner test

nano detect_outliers_30kb.R

---
library(readr)
library(dplyr)
library(EnvStats)

GD <- "/home/MBEacherin/yeray/genomes_comparison/genetic_distance"

tables_dir <- file.path(GD, "tables")

files <- c(
  "MED_vs_ATL_30kb.tsv",
  "MED_vs_PAC_30kb.tsv",
  "ATL_vs_PAC_30kb.tsv"
)

all_outliers <- list()

for (f in files) {

  cat("\nProcessing", f, "\n")

  df <- read_tsv(
    file.path(tables_dir, f),
    show_col_types = FALSE
  )

  comp <- unique(df$comparison)

  df <- df %>%
    mutate(
      window_id = paste(chromosome, window_start, window_end, sep = "_")
    )

  x <- df$genetic_distance

  mean_gd <- mean(x, na.rm = TRUE)
  sd_gd <- sd(x, na.rm = TRUE)

  q1 <- quantile(x, 0.25, na.rm = TRUE)
  q3 <- quantile(x, 0.75, na.rm = TRUE)
  iqr <- q3 - q1

  p99 <- quantile(x, 0.99, na.rm = TRUE)
  p995 <- quantile(x, 0.995, na.rm = TRUE)
  p999 <- quantile(x, 0.999, na.rm = TRUE)

  df <- df %>%
    mutate(
      outlier_2sd = genetic_distance > mean_gd + 2 * sd_gd,
      outlier_3sd = genetic_distance > mean_gd + 3 * sd_gd,
      outlier_iqr = genetic_distance > q3 + 1.5 * iqr,
      outlier_p99 = genetic_distance >= p99,
      outlier_p995 = genetic_distance >= p995,
      outlier_p999 = genetic_distance >= p999
    )

  # Rosner test
  clean_df <- df %>%
    filter(!is.na(genetic_distance))

  k_max <- min(1000, nrow(clean_df) - 2)

  rosner <- rosnerTest(clean_df$genetic_distance, k = k_max)

  rosner_rows <- rosner$all.stats$Obs.Num[
    rosner$all.stats$Outlier
  ]

  clean_df$outlier_rosner <- FALSE
  clean_df$outlier_rosner[rosner_rows] <- TRUE

  df <- df %>%
    left_join(
      clean_df %>%
        select(window_id, outlier_rosner),
      by = "window_id"
    ) %>%
    mutate(
      outlier_rosner = ifelse(is.na(outlier_rosner), FALSE, outlier_rosner)
    )

  out_full <- gsub(".tsv", "_with_outlier_tests.tsv", f)
  out_only <- gsub(".tsv", "_outliers_only.tsv", f)

  write_tsv(
    df,
    file.path(tables_dir, out_full)
  )

  outliers <- df %>%
    filter(
      outlier_2sd |
        outlier_3sd |
        outlier_iqr |
        outlier_p99 |
        outlier_p995 |
        outlier_p999 |
        outlier_rosner
    )

  write_tsv(
    outliers,
    file.path(tables_dir, out_only)
  )

  all_outliers[[comp]] <- outliers

  cat("2SD:", sum(df$outlier_2sd), "\n")
  cat("3SD:", sum(df$outlier_3sd), "\n")
  cat("IQR:", sum(df$outlier_iqr), "\n")
  cat("P99:", sum(df$outlier_p99), "\n")
  cat("P99.5:", sum(df$outlier_p995), "\n")
  cat("P99.9:", sum(df$outlier_p999), "\n")
  cat("Rosner:", sum(df$outlier_rosner), "\n")
}

combined <- bind_rows(all_outliers)

write_tsv(
  combined,
  file.path(tables_dir, "ALL_30kb_outliers_tests.tsv")
)

cat("\nDone. Combined outliers written to ALL_30kb_outliers_tests.tsv\n")
