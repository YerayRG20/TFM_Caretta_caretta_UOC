#!/usr/bin/env python3
from pathlib import Path
import csv

BASE = Path("/home/MBEacherin/yeray/genomes_comparison/genetic_distance")
IN_DIR = BASE / "tables"
OUT = BASE / "tables" / "chromosome_mean_genetic_distance.tsv"

FILES = [
    "MED_vs_ATL_30kb.tsv",
    "MED_vs_PAC_30kb.tsv",
    "ATL_vs_PAC_30kb.tsv",
]

rows = []

for fname in FILES:
    path = IN_DIR / fname
    sums = {}
    counts = {}

    with path.open() as fh:
        reader = csv.DictReader(fh, delimiter="\t")
        for r in reader:
            comp = r["comparison"]
            chrom = r["chromosome"]
            gd = float(r["genetic_distance"])
            key = (comp, chrom)

            sums[key] = sums.get(key, 0.0) + gd
            counts[key] = counts.get(key, 0) + 1

    for (comp, chrom), total in sums.items():
        mean_gd = total / counts[(comp, chrom)]
        rows.append((comp, chrom, counts[(comp, chrom)], mean_gd))

rows.sort()

with OUT.open("w") as out:
    out.write("comparison\tchromosome\tn_windows\tmean_genetic_distance\n")
    for comp, chrom, nwin, mean_gd in rows:
        out.write(f"{comp}\t{chrom}\t{nwin}\t{mean_gd:.8f}\n")

print(f"[OK] wrote {OUT}")
