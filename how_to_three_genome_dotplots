  "/home/MBEacherin/yeray/genomes/GCA_023653815.1_GSC_CCare_1.0_genomic.fna.fai",
  col_names = FALSE,
  show_col_types = FALSE
) %>%
  slice(1:28) %>%
  transmute(chr = X1, chr_len = X2, chr_rank = row_number())

atl_order_ref <- dot_med_atl %>%
  inner_join(
    med_fai_ref %>% select(chr, chr_rank),
    by = c("tname" = "chr")
  ) %>%
  group_by(qname, chr_rank) %>%
  summarise(total_aln = sum(alen), .groups = "drop") %>%
  group_by(qname) %>%
  slice_max(order_by = total_aln, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  arrange(chr_rank)

atl_fai <- atl_fai %>%
  left_join(atl_order_ref %>% select(qname, chr_rank), by = c("chr" = "qname")) %>%
  filter(!is.na(chr_rank)) %>%
  arrange(chr_rank) %>%
  mutate(chr_rank = row_number())

pac_fai_raw <- read_tsv(
  "/home/MBEacherin/yeray/genomes/GCF_965140235.1_rCarCar1.hap1_genomic.fna.fai",
  col_names = FALSE,
  show_col_types = FALSE
) %>%
  slice(1:28) %>%
  transmute(chr = X1, chr_len = X2)

pac_order <- dot %>%
  inner_join(
    atl_fai %>% select(chr, chr_rank),
    by = c("tname" = "chr")
  ) %>%
  group_by(qname, chr_rank) %>%
  summarise(total_aln = sum(alen), .groups = "drop") %>%
  group_by(qname) %>%
  slice_max(order_by = total_aln, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  arrange(chr_rank)

pac_orientation <- dot %>%
  inner_join(
    pac_order %>% select(qname, chr_rank),
    by = "qname"
  ) %>%
  group_by(qname) %>%
  summarise(
    plus_aln  = sum(alen[strand == "+"], na.rm = TRUE),
    minus_aln = sum(alen[strand == "-"], na.rm = TRUE),
    orientation = ifelse(minus_aln > plus_aln, "-", "+"),
    .groups = "drop"
  )

pac_fai <- pac_fai_raw %>%
  left_join(pac_order %>% select(qname, chr_rank), by = c("chr" = "qname")) %>%
  left_join(pac_orientation %>% select(qname, orientation), by = c("chr" = "qname")) %>%
  filter(!is.na(chr_rank)) %>%
  arrange(chr_rank) %>%
  mutate(
    chr_rank = row_number(),
    orientation = ifelse(is.na(orientation), "+", orientation)
  )

atl_fai <- atl_fai %>%
  mutate(offset = lag(cumsum(chr_len), default = 0))

pac_fai <- pac_fai %>%
  mutate(offset = lag(cumsum(chr_len), default = 0))

dot2 <- dot %>%
  inner_join(atl_fai, by = c("tname" = "chr")) %>%
  rename(
    t_chr_len_main = chr_len,
    t_chr_rank = chr_rank,
    t_offset = offset
  ) %>%
  inner_join(pac_fai, by = c("qname" = "chr")) %>%
  rename(
    q_chr_len_main = chr_len,
    q_chr_rank = chr_rank,
    q_offset = offset,
    q_orientation = orientation
  ) %>%
  mutate(
    x_start = t_offset + tstart,
    x_end   = t_offset + tend,

    y_start = ifelse(
      q_orientation == "+",
      q_offset + qstart,
      q_offset + (q_chr_len_main - qend)
    ),

    y_end = ifelse(
      q_orientation == "+",
      q_offset + qend,
      q_offset + (q_chr_len_main - qstart)
    ),

    pid = 100 * nmatch / alen,
    pid_class = case_when(
      pid < 25 ~ "<25%",
      pid < 50 ~ "25-50%",
      pid < 75 ~ "50-75%",
      TRUE ~ ">75%"
    )
  )

print(table(dot2$q_orientation, useNA = "ifany"))

atl_bounds <- atl_fai %>%
  mutate(
    boundary = offset,
    midpoint = offset + chr_len / 2
  )

pac_bounds <- pac_fai %>%
  mutate(
    boundary = offset,
    midpoint = offset + chr_len / 2
  )

p <- ggplot(dot2) +
  geom_segment(
    aes(
      x = x_start, xend = x_end,
      y = y_start, yend = y_end,
      color = pid_class
    ),
    linewidth = 0.5,
    alpha = 0.9
  ) +
  geom_vline(
    data = atl_bounds,
    aes(xintercept = boundary),
    color = "grey85",
    linewidth = 0.3
  ) +
  geom_hline(
    data = pac_bounds,
    aes(yintercept = boundary),
    color = "grey85",
    linewidth = 0.3
  ) +
  scale_x_continuous(
    breaks = c(atl_bounds$midpoint[1:11], mean(range(atl_bounds$midpoint[12:28]))),
    labels = c(as.character(1:11), "12-28"),
    expand = c(0, 0)
  ) +
  scale_y_continuous(
    breaks = c(pac_bounds$midpoint[1:11], mean(range(pac_bounds$midpoint[12:28]))),
    labels = c(as.character(1:11), "12-28"),
    expand = c(0, 0)
  ) +
  scale_color_manual(
    values = c(
      "<25%" = "#f1c27d",
      "25-50%" = "#d08c3f",
      "50-75%" = "#4f81bd",
      ">75%" = "black"
    ),
    breaks = c("<25%", "25-50%", "50-75%", ">75%"),
    drop = FALSE
  ) +
  coord_fixed() +
  labs(
    x = "NEA genome chromosome",
    y = "NP genome chromosome",
    color = NULL
  ) +
  theme_bw(base_size = 12) +
  theme(
    panel.grid = element_blank(),
    axis.text.x = element_text(size = 8),
    axis.text.y = element_text(size = 8)
  )

ggsave(
  file.path(DOT, "ATL_vs_PAC_dotplot_concat_oriented.png"),
  p,
  width = 7.5,
  height = 7.5,
  dpi = 300
)
