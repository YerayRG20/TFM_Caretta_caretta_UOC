library(ggplot2)
library(readr)
library(dplyr)
library(stringr)

dot <- read_tsv("/home/MBEacherin/yeray/genomes_comparison/dotplots/tsv/MED_vs_ATL.filtered.tsv",
                col_names = FALSE, show_col_types = FALSE)

colnames(dot) <- c("qname","qlen","qstart","qend","strand",
                   "tname","tlen","tstart","tend","nmatch","alen","mapq")

# Parse chromosome numbers from names like OZ220763.1 / CM042760.1
dot <- dot %>%
  mutate(
    qchr = as.integer(str_extract(qname, "(?<=\\D)\\d+(?=\\.1$)")),
    tchr = as.integer(str_extract(tname, "(?<=\\D)\\d+(?=\\.1$)"))
  )

# Re-rank to 1..28 by chromosome size order within each assembly
# Keep only the 28 main chromosomes by chromosome length rank
q_levels <- dot %>%
  distinct(qname, qlen) %>%
  arrange(desc(qlen)) %>%
  slice(1:28) %>%
  mutate(qrank = row_number())

t_levels <- dot %>%
  distinct(tname, tlen) %>%
  arrange(desc(tlen)) %>%
  slice(1:28) %>%
  mutate(trank = row_number())

dot <- dot %>%
  left_join(q_levels, by = c("qname","qlen")) %>%
  left_join(t_levels, by = c("tname","tlen")) %>%
  filter(!is.na(qrank), !is.na(trank)) %>%
  mutate(
    pid = 100 * nmatch / alen,
    pid_class = case_when(
      pid < 25 ~ "<25%",
      pid < 50 ~ "25-50%",
      pid < 75 ~ "50-75%",
      TRUE ~ ">75%"
    ),
    qmid = (qstart + qend) / 2,
    tmid = (tstart + tend) / 2
  )

# chromosome boundaries for grid
q_bounds <- q_levels %>% arrange(qrank) %>% mutate(x = qrank)
t_bounds <- t_levels %>% arrange(trank) %>% mutate(y = trank)

p <- ggplot(dot, aes(x = qrank, y = trank, color = pid_class)) +
  geom_point(size = 2, alpha = 0.8) +
  scale_x_continuous(
  breaks = 1:28,
  labels = 1:28,
  expand = c(0, 0)
) +
scale_y_continuous(
  breaks = 1:28,
  labels = 1:28,
  expand = c(0, 0)
  ) +
  scale_color_manual(
  values = c("<25%" = "#f1c27d",
             "25-50%" = "#d08c3f",
             "50-75%" = "#4f81bd",
             ">75%" = "black"),
  breaks = c("<25%", "25-50%", "50-75%", ">75%"),
  drop = FALSE
  ) +
  geom_vline(xintercept = seq(0.5, 28.5, by = 1), color = "grey80", linewidth = 0.3) +
  geom_hline(yintercept = seq(0.5, 28.5, by = 1), color = "grey80", linewidth = 0.3) +
  coord_fixed() +
  labs(
    title = "Whole-genome alignment dot plot: MED vs ATL",
    x = "MED genome chromosome",
    y = "ATL genome chromosome",
    color = NULL
  ) +
  theme_bw(base_size = 12) +
  theme(
    panel.grid = element_blank(),
    axis.text.x = element_text(angle = 0),
    plot.title = element_text(face = "bold")
  )

ggsave("/home/MBEacherin/yeray/genomes_comparison/dotplots/MED_vs_ATL_dotplot_chr.png",
       p, width = 7, height = 7, dpi = 300)
