library(ggplot2)
library(readr)
library(dplyr)
library(tidyr)

DOT <- "/home/MBEacherin/yeray/genomes_comparison/dotplots"

dot <- read_tsv(
  file.path(DOT, "tsv", "MED_vs_PAC.filtered.tsv"),
  col_names = FALSE,
  show_col_types = FALSE
)

colnames(dot) <- c(
  "qname","qlen","qstart","qend","strand",
  "tname","tlen","tstart","tend",
  "nmatch","alen","mapq"
)

med_fai <- read_tsv(
  "/home/MBEacherin/yeray/genomes/GCA_023653815.1_GSC_CCare_1.0_genomic.fna.fai",
  col_names = FALSE,
  show_col_types = FALSE
) %>%
  slice(1:28) %>%
  transmute(chr = X1, chr_len = X2, chr_rank = row_number())

pac_fai_raw <- read_tsv(
  "/home/MBEacherin/yeray/genomes/GCF_965140235.1_rCarCar1.hap1_genomic.fna.fai",
  col_names = FALSE,
  show_col_types = FALSE
) %>%
  slice(1:28) %>%
  transmute(chr = X1, chr_len = X2)

# 1. Assignar cada cromosoma PAC al cromosoma MED amb què alinea més
pac_order <- dot %>%
  inner_join(
    med_fai %>% select(chr, chr_rank),
    by = c("tname" = "chr")
  ) %>%
  group_by(qname, chr_rank) %>%
  summarise(total_aln = sum(alen), .groups = "drop") %>%
  group_by(qname) %>%
  slice_max(order_by = total_aln, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  arrange(chr_rank)

# 2. Orientació dominant de cada cromosoma PAC respecte MED
pac_orientation <- dot %>%
  inner_join(
    pac_order %>% select(qname, chr_rank),
    by = "qname"
  ) %>%
  group_by(qname) %>%
  summarise(
    plus_aln  = sum(alen[strand == "+"], na.rm = TRUE),
    minus_aln = sum(alen[strand == "-"], na.rm = TRUE),
    orientation = ifelse(minus_aln > plus_aln, "-", "+"),
    .groups = "drop"
  )

# 3. Taula final PAC ordenada i amb orientació
pac_fai <- pac_fai_raw %>%
  left_join(pac_order %>% select(qname, chr_rank), by = c("chr" = "qname")) %>%
  left_join(pac_orientation %>% select(qname, orientation), by = c("chr" = "qname")) %>%
  filter(!is.na(chr_rank)) %>%
  arrange(chr_rank) %>%
  mutate(
    chr_rank = row_number(),
    orientation = ifelse(is.na(orientation), "+", orientation)
  )

# 4. Offsets acumulats
med_fai <- med_fai %>%
  mutate(offset = lag(cumsum(chr_len), default = 0))

pac_fai <- pac_fai %>%
  mutate(offset = lag(cumsum(chr_len), default = 0))

# 5. Afegir coordenades acumulades
dot2 <- dot %>%
  inner_join(med_fai, by = c("tname" = "chr")) %>%
  rename(
    t_chr_len_main = chr_len,
    t_chr_rank = chr_rank,
    t_offset = offset
  ) %>%
  inner_join(pac_fai, by = c("qname" = "chr")) %>%
  rename(
    q_chr_len_main = chr_len,
    q_chr_rank = chr_rank,
    q_offset = offset,
    q_orientation = orientation
  ) %>%
  mutate(
    x_start = t_offset + tstart,
    x_end   = t_offset + tend,

    # IMPORTANT:
    # Si el cromosoma PAC està invertit respecte MED,
    # girem les coordenades del cromosoma sencer.
    y_start = ifelse(
      q_orientation == "+",
      q_offset + qstart,
      q_offset + (q_chr_len_main - qend)
    ),
    y_end = ifelse(
      q_orientation == "+",
      q_offset + qend,
      q_offset + (q_chr_len_main - qstart)
    ),

    pid = 100 * nmatch / alen,
    pid_class = case_when(
      pid < 25 ~ "<25%",
      pid < 50 ~ "25-50%",
      pid < 75 ~ "50-75%",
      TRUE ~ ">75%"
    )
  )

# Debug útil
print(table(dot2$q_orientation, useNA = "ifany"))

med_bounds <- med_fai %>%
  mutate(
    boundary = offset,
    midpoint = offset + chr_len / 2
  )

pac_bounds <- pac_fai %>%
  mutate(
    boundary = offset,
    midpoint = offset + chr_len / 2
  )

p <- ggplot(dot2) +
  geom_segment(
    aes(
      x = x_start, xend = x_end,
      y = y_start, yend = y_end,
      color = pid_class
    ),
