library(ggplot2)
library(readr)
library(dplyr)
library(tidyr)

DOT <- "/home/MBEacherin/yeray/genomes_comparison/dotplots"

# -----------------------------
# 1. Read filtered PAF table
# -----------------------------
dot <- read_tsv(
  file.path(DOT, "tsv", "MED_vs_ATL.filtered.tsv"),
  col_names = FALSE,
  show_col_types = FALSE
)

colnames(dot) <- c(
  "qname","qlen","qstart","qend","strand",
  "tname","tlen","tstart","tend",
  "nmatch","alen","mapq"
)

# -----------------------------
# 2. Read first 28 chromosomes from each genome
# -----------------------------
med_fai <- read_tsv(
  "/home/MBEacherin/yeray/genomes/GCA_023653815.1_GSC_CCare_1.0_genomic.fna.fai",
  col_names = FALSE,
  show_col_types = FALSE
) %>%
  slice(1:28) %>%
  transmute(chr = X1, chr_len = X2, chr_rank = row_number())

atl_fai <- read_tsv(
  "/home/MBEacherin/yeray/genomes/GCA_965117115.1_CarCar_QM_v1.21.12_Sc_genomic.fna.fai",
  col_names = FALSE,
  show_col_types = FALSE
) %>%
  slice(1:28) %>%
  transmute(chr = X1, chr_len = X2)

# provisional mapping table to infer ATL order from strongest alignment to MED
atl_order <- dot %>%
  inner_join(
    med_fai %>% select(chr, chr_rank),
    by = c("tname" = "chr")
  ) %>%
  group_by(qname, chr_rank) %>%
  summarise(total_aln = sum(alen), .groups = "drop") %>%
  group_by(qname) %>%
  slice_max(order_by = total_aln, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  arrange(chr_rank)

# assign ATL chromosome ranks based on best-hit MED chromosome order
atl_fai <- atl_fai %>%
  left_join(atl_order %>% select(qname, chr_rank), by = c("chr" = "qname")) %>%
  arrange(chr_rank, desc(chr_len)) %>%
  mutate(chr_rank = row_number())

# cumulative offsets
med_fai <- med_fai %>%
  mutate(offset = lag(cumsum(chr_len), default = 0))

atl_fai <- atl_fai %>%
  mutate(offset = lag(cumsum(chr_len), default = 0))

# -----------------------------
# 3. Keep only alignments involving the 28 main chromosomes
# -----------------------------
dot2 <- dot %>%
  inner_join(med_fai, by = c("tname" = "chr")) %>%
  rename(t_chr_len_main = chr_len, t_chr_rank = chr_rank, t_offset = offset) %>%
  inner_join(atl_fai, by = c("qname" = "chr")) %>%
  rename(q_chr_len_main = chr_len, q_chr_rank = chr_rank, q_offset = offset)

# -----------------------------
# 4. Compute cumulative genomic coordinates
# -----------------------------
dot2 <- dot2 %>%
  mutate(
    # x axis = MED (target in minimap2 call)
    x_start = t_offset + tstart,
    x_end   = t_offset + tend,

    # y axis = ATL (query in minimap2 call)
    y_start = ifelse(strand == "+", q_offset + qstart, q_offset + qend),
    y_end   = ifelse(strand == "+", q_offset + qend,   q_offset + qstart),

    pid = 100 * nmatch / alen,
    pid_class = case_when(
      pid < 25 ~ "<25%",
      pid < 50 ~ "25-50%",
      pid < 75 ~ "50-75%",
      TRUE ~ ">75%"
    )
  )

# -----------------------------
# 5. Chromosome boundaries and labels
# -----------------------------
med_bounds <- med_fai %>%
  mutate(boundary = offset,
         midpoint = offset + chr_len / 2)

atl_bounds <- atl_fai %>%
  mutate(boundary = offset,
         midpoint = offset + chr_len / 2)

med_end <- max(med_fai$offset + med_fai$chr_len)
atl_end <- max(atl_fai$offset + atl_fai$chr_len)

# -----------------------------
# 6. Plot segments (paper-like)
# -----------------------------
p <- ggplot(dot2) +
  geom_segment(
    aes(
      x = x_start, xend = x_end,
      y = y_start, yend = y_end,
      color = pid_class
    ),
    linewidth = 0.5,
    alpha = 0.9
  ) +
  geom_vline(
    data = med_bounds,
    aes(xintercept = boundary),
    color = "grey85",
    linewidth = 0.3
  ) +
  geom_hline(
    data = atl_bounds,
    aes(yintercept = boundary),
    color = "grey85",
    linewidth = 0.3
  ) +
  scale_x_continuous(
  breaks = c(med_bounds$midpoint[1:11], mean(range(med_bounds$midpoint[12:28]))),
  labels = c(as.character(1:11), "12-28"),
  expand = c(0, 0)
) +
scale_y_continuous(
  breaks = c(atl_bounds$midpoint[1:11], mean(range(atl_bounds$midpoint[12:28]))),
  labels = c(as.character(1:11), "12-28"),
  expand = c(0, 0)
  ) +
  scale_color_manual(
    values = c(
      "<25%" = "#f1c27d",
      "25-50%" = "#d08c3f",
      "50-75%" = "#4f81bd",
      ">75%" = "black"
    ),
    breaks = c("<25%", "25-50%", "50-75%", ">75%"),
    drop = FALSE
  ) +
  coord_fixed() +
  labs(
    x = "MED genome chromosome",
    y = "NEA genome chromosome",
    color = NULL
  ) +
  theme_bw(base_size = 12) +
  theme(
    panel.grid = element_blank(),
    axis.text.x = element_text(size = 8),
    axis.text.y = element_text(size = 8)
  )

ggsave(
  file.path(DOT, "MED_vs_ATL_dotplot_concat.png"),
  p,
  width = 7.5,
  height = 7.5,
  dpi = 300
)
