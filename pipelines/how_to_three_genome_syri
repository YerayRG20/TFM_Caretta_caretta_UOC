# ----------------------------
# Load tools
# ----------------------------
. /etc/profile
module load anaconda/2024.02
source /aplic/anaconda/2024.02/etc/profile.d/conda.sh
conda activate /home/MBEacherin/yeray/bio_env

set -euo pipefail

# ----------------------------
# Basic checks
# ----------------------------
command -v samtools >/dev/null 2>&1 || { echo "samtools not found"; exit 1; }
command -v minimap2 >/dev/null 2>&1 || { echo "minimap2 not found"; exit 1; }
command -v python >/dev/null 2>&1 || { echo "python not found"; exit 1; }
command -v seqtk >/dev/null 2>&1 || { echo "seqtk not found"; exit 1; }

[ -f "$BASE/MED_28chr.list" ] || { echo "Missing $BASE/MED_28chr.list"; exit 1; }
[ -f "$BASE/ATL_28chr.list" ] || { echo "Missing $BASE/ATL_28chr.list"; exit 1; }
[ -f "$BASE/ATL_28chr_correct.list" ] || { echo "Missing $BASE/ATL_28chr_correct.list"; exit 1; }
[ -f "$BASE/PAC_28chr.list" ] || { echo "Missing $BASE/PAC_28chr.list"; exit 1; }
[ -f "$PLOT_SCRIPT" ] || { echo "Missing $PLOT_SCRIPT"; exit 1; }

# ----------------------------
