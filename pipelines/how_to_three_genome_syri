        #!/usr/bin/env python3

import argparse
import sys
import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
from matplotlib.path import Path
import matplotlib.patches as patches

# ── Variant colours ──────────────────────────────────────────────────────────
# Maps canonical type → colour. AL-suffix variants are normalised to canonical.
COLORS = {
    "SYN"   : "#B8B8B8",   # synteny – grey
    "REARR" : "#FF4500",   # rearrangements – same as old inversion
}

GENOME_COLORS = {
    "NEA": "#4999B6",
    "MED": "#FFD93D",
    "NP" : "#ACACA7",
}

# Map every SyRI tag (including AL variants) to a canonical type
TAG_TO_CANONICAL = {
    "SYN"    : "SYN",
    "SYNAL"  : "SYN",
    "INV"    : "REARR",
    "INVAL"  : "REARR",
    "TRANS"  : "REARR",
    "TRANSAL": "REARR",
    "INVTR"  : "REARR",
    "INVTRAL": "REARR",
    "DUP"    : "REARR",
    "DUPAL"  : "REARR",
    "INVDP"  : "REARR",
    "INVDPAL": "REARR",
}
KEEP_TYPES = set(TAG_TO_CANONICAL.keys())


def parse_fai(fai_path):
    """Return ordered dict {chr_name: length} from a .fai file."""
    chrom_lengths = {}
    with open(fai_path) as fh:
        for line in fh:
            parts = line.strip().split("\t")
            chrom_lengths[parts[0]] = int(parts[1])
    return chrom_lengths


def parse_syri(syri_path, min_size=0):
    """Parse syri.out and return a DataFrame of relevant rows."""
    rows = []
    with open(syri_path) as fh:
        for line in fh:
            if line.startswith("#"):
                continue
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 11:
                continue
            var_type = parts[10].strip()
            if var_type not in TAG_TO_CANONICAL:
                continue
            canonical = TAG_TO_CANONICAL[var_type]
            try:
                ref_start = int(parts[1])
                ref_end   = int(parts[2])
                qry_start = int(parts[6])
                qry_end   = int(parts[7])
            except ValueError:
                continue
            if abs(ref_end - ref_start) < min_size:
                continue
            rows.append({
                "ref_chr"   : parts[0],
                "ref_start" : ref_start,
                "ref_end"   : ref_end,
                "qry_chr"   : parts[5],
                "qry_start" : qry_start,
                "qry_end"   : qry_end,
                "var_type"  : canonical,
            })
    return pd.DataFrame(rows)


def chrom_offsets(chrom_lengths, gap_frac=0.01):
    """
    Compute x-offsets for each chromosome so they sit side-by-side.
    Returns (offsets dict, total_span).
    gap = gap_frac * total_genome_length inserted between each chromosome.
    """
    total = sum(chrom_lengths.values())
    gap   = total * gap_frac
    offset = 0.0
    offsets = {}
    for chrom, length in chrom_lengths.items():
        offsets[chrom] = offset
        offset += length + gap
    total_span = offset - gap
    return offsets, total_span


def bezier_ribbon(ax, x1a, x1b, x2a, x2b, y_top, y_bot, color, alpha):
    """
    Draw a filled Bezier ribbon connecting [x1a, x1b] on y_top
    to [x2a, x2b] on y_bot.
    """
    ctrl_y = (y_top + y_bot) / 2

    verts = [
        (x1a, y_top),
        (x1a, ctrl_y), (x2a, ctrl_y),
        (x2a, y_bot),
        (x2b, y_bot),
        (x2b, ctrl_y), (x1b, ctrl_y),
        (x1b, y_top),
        (x1a, y_top),
    ]
    codes = [
        Path.MOVETO,
        Path.CURVE4, Path.CURVE4, Path.CURVE4,
        Path.LINETO,
        Path.CURVE4, Path.CURVE4, Path.CURVE4,
        Path.CLOSEPOLY,
    ]
    path  = Path(verts, codes)
    patch = patches.PathPatch(path, facecolor=color, edgecolor="none", alpha=alpha, zorder=1)
    ax.add_patch(patch)


def draw_chromosomes(ax, chrom_lengths, offsets, total_span, y, bar_height,
                     label_above=True, color="#555555"):
    """Draw chromosome bars and staggered labels to reduce overlap."""
    for i, (chrom, length) in enumerate(chrom_lengths.items()):
        x0 = offsets[chrom]
        x1 = x0 + length

        # chromosome bar
        ax.add_patch(mpatches.FancyBboxPatch(
            (x0, y - bar_height / 2), length, bar_height,
            boxstyle="round,pad=0",
            facecolor=color, edgecolor="white", linewidth=0.5, zorder=3
        ))

        # chromosome label
        label = chrom.split("_")[-1]
        label = label.replace("Chromosome", "Chr ")

        mid_x = x0 + length / 2

        # Alternate label height to avoid overlap, especially in microchromosomes
        if label_above:
            level = [1.8, 2.8, 3.8][i % 3]
            label_y = y + bar_height * level
        else:
            level = [1.8, 2.8, 3.8][i % 3]
            label_y = y - bar_height * level

        # Smaller font for tiny chromosomes
        if length < total_span * 0.03:
            fontsize = 6
        elif length < total_span * 0.06:
            fontsize = 6.5
        else:
            fontsize = 7

        ax.text(mid_x, label_y, label,
                ha="center", va="center",
                fontsize=fontsize, color="#333333",
                fontweight="bold")


def main():
    parser = argparse.ArgumentParser(description="Plot SyRI synteny ribbons.")
    parser.add_argument("--syri",      required=True,  help="Path to syri.out")
    parser.add_argument("--ref_fai",   required=True,  help="Reference .fai index")
    parser.add_argument("--qry_fai",   required=True,  help="Query .fai index")
    parser.add_argument("--output",    default="synteny_plot", help="Output prefix")
    parser.add_argument("--ref_name",  default="Inner Form",   help="Reference genome label")
    parser.add_argument("--qry_name",  default="Outer Form",   help="Query genome label")
    parser.add_argument("--min_size",  type=int, default=10000, help="Min block size (bp)")
    parser.add_argument("--alpha",     type=float, default=0.75, help="Ribbon alpha")
    parser.add_argument("--fig_width", type=float, default=20)
    parser.add_argument("--fig_height",type=float, default=6)
    args = parser.parse_args()

    # ── Load data ─────────────────────────────────────────────────────────────
    print("Loading FAI files...")
    ref_lengths = parse_fai(args.ref_fai)
    qry_lengths = parse_fai(args.qry_fai)

    print("Parsing SyRI output...")
    df = parse_syri(args.syri, min_size=args.min_size)
    if df.empty:
        sys.exit("ERROR: No variants passed filters. Check --min_size or variant types.")
    print(f"  {len(df)} blocks to plot.")
    print(f"  Variant counts:\n{df['var_type'].value_counts().to_string()}")

    # ── Compute offsets ────────────────────────────────────────────────────────
    ref_offsets, ref_span = chrom_offsets(ref_lengths)
    qry_offsets, qry_span = chrom_offsets(qry_lengths)
    total_span = max(ref_span, qry_span)

    # Normalise both genomes to the same total width
    ref_scale = total_span / ref_span
    qry_scale = total_span / qry_span
    ref_offsets = {k: v * ref_scale for k, v in ref_offsets.items()}
    ref_lengths_scaled = {k: v * ref_scale for k, v in ref_lengths.items()}
    qry_offsets = {k: v * qry_scale for k, v in qry_offsets.items()}
    qry_lengths_scaled = {k: v * qry_scale for k, v in qry_lengths.items()}

    # ── Canvas ─────────────────────────────────────────────────────────────────
    fig, ax = plt.subplots(figsize=(args.fig_width, args.fig_height))
    fig.patch.set_facecolor("white")
    ax.set_facecolor("white")

    Y_TOP = 1.0    # reference genome y
    Y_BOT = 0.0    # query genome y
    BAR_H = 0.06

    # ── Ribbons ────────────────────────────────────────────────────────────────
    # Draw SYN first (bottom layer), then SVs on top
    order = ["SYN", "REARR"]
    for vtype in order:
        subset = df[df["var_type"] == vtype]
        for _, row in subset.iterrows():
            rc = row["ref_chr"]
            qc = row["qry_chr"]
            if rc not in ref_offsets or qc not in qry_offsets:
                continue
            x1a = ref_offsets[rc] + row["ref_start"] * ref_scale
            x1b = ref_offsets[rc] + row["ref_end"]   * ref_scale
            x2a = qry_offsets[qc] + row["qry_start"] * qry_scale
            x2b = qry_offsets[qc] + row["qry_end"]   * qry_scale
            color = COLORS.get(vtype, "#999999")
            bezier_ribbon(ax, x1a, x1b, x2a, x2b,
                          Y_TOP - BAR_H / 2, Y_BOT + BAR_H / 2,
                          color, args.alpha)

    # ── Chromosome bars ────────────────────────────────────────────────────────
    draw_chromosomes(ax, ref_lengths_scaled, ref_offsets, total_span,
                     Y_TOP, BAR_H, label_above=True,
                     color=GENOME_COLORS.get(args.ref_name, "#444444"))
    draw_chromosomes(ax, qry_lengths_scaled, qry_offsets, total_span,
                     Y_BOT, BAR_H, label_above=False,
                     color=GENOME_COLORS.get(args.qry_name, "#444444"))

    # ── Genome labels ──────────────────────────────────────────────────────────
    ax.text(-total_span * 0.01, Y_TOP, args.ref_name,
            ha="right", va="center", fontsize=11, fontstyle="italic",
            color="#222222", fontweight="bold")
    ax.text(-total_span * 0.01, Y_BOT, args.qry_name,
            ha="right", va="center", fontsize=11, fontstyle="italic",
            color="#222222", fontweight="bold")

    # ── Legend ─────────────────────────────────────────────────────────────────
    legend_items = {
        "Synteny"        : COLORS["SYN"],
        "Rearrangements" : COLORS["REARR"],
    }
    handles = [mpatches.Patch(facecolor=c, edgecolor="grey",
                               linewidth=0.5, label=l)
               for l, c in legend_items.items()]
    ax.legend(handles=handles, loc="upper right", frameon=False,
              fontsize=8, ncol=2, bbox_to_anchor=(1.0, 1.25))

    # ── Axes cleanup ───────────────────────────────────────────────────────────
    ax.set_xlim(-total_span * 0.13, total_span * 1.01)
    ax.set_ylim(Y_BOT - 0.40, Y_TOP + 0.40)
    ax.axis("off")
    plt.tight_layout()

    # ── Save ───────────────────────────────────────────────────────────────────
    png_out = f"{args.output}.png"
    svg_out = f"{args.output}.svg"
    fig.savefig(png_out, dpi=300, bbox_inches="tight", facecolor="white")
    fig.savefig(svg_out, bbox_inches="tight", facecolor="white")
    print(f"Saved: {png_out}")
    print(f"Saved: {svg_out}")
    plt.close()


if __name__ == "__main__":
    main()

