# ----------------------------
[ -f "${MED}.fai" ] || samtools faidx "$MED"
[ -f "${ATL}.fai" ] || samtools faidx "$ATL"
[ -f "${PAC}.fai" ] || samtools faidx "$PAC"

# ----------------------------
# Extract chromosome-only FASTA
# IMPORTANT:
# - MED and PAC stay as before
# - ATL_28chr.fna = old order (for MED_vs_ATL, which already works)
# - ATL_28chr_correct.fna = corrected order (only for ATL_vs_PAC)
# ----------------------------
echo "[$(date)] Extracting chromosome-only FASTA"

samtools faidx "$MED" $(cat "$BASE/MED_28chr.list") > "$BASE/MED_28chr.fna"
samtools faidx "$ATL" $(cat "$BASE/ATL_28chr.list") > "$BASE/ATL_28chr.fna"
samtools faidx "$ATL" $(cat "$BASE/ATL_28chr_correct.list") > "$BASE/ATL_28chr_correct.fna"
samtools faidx "$PAC" $(cat "$BASE/PAC_28chr.list") > "$BASE/PAC_28chr.fna"

samtools faidx "$BASE/MED_28chr.fna"
samtools faidx "$BASE/ATL_28chr.fna"
samtools faidx "$BASE/ATL_28chr_correct.fna"
samtools faidx "$BASE/PAC_28chr.fna"

# ----------------------------
# Helper: build besthits map
# ref_chr   qry_chr   aligned_bases
# ----------------------------
make_besthits() {
    local paf="$1"
    local out="$2"

    awk '{print $6"\t"$1"\t"$10}' "$paf" \
    | sort -k1,1 -k3,3nr \
    | awk '!seen[$1]++' \
    > "$out"
}

# ----------------------------
# Helper: build reordered query list from besthits
# Only first 28 lines = main chromosomes
# ----------------------------
make_reordered_list() {
    local besthits="$1"
    local outlist="$2"

    head -28 "$besthits" | cut -f2 > "$outlist"
}

# ----------------------------
# Helper: rename fasta as Chr01..Chr28
# ----------------------------
rename_chr_pad() {
    local infa="$1"
    local outfa="$2"

    awk 'BEGIN{n=0} /^>/{n++; printf(">Chr%02d\n", n); next} {print}' "$infa" > "$outfa"
    samtools faidx "$outfa"
}

# ----------------------------
# Helper: RC-fix selected chromosomes in query FASTA
# Keeps chromosome order intact
# ----------------------------
make_rc_fixed_query() {
    local infa="$1"
    local chrlist="$2"
    local outfa="$3"

    rm -f "$outfa"

    while read -r chr; do
        if grep -qx "$chr" "$chrlist"; then
            seqtk seq -r <(samtools faidx "$infa" "$chr") >> "$outfa"
        else
            samtools faidx "$infa" "$chr" >> "$outfa"
        fi
    done < <(cut -f1 "${infa}.fai")

    samtools faidx "$outfa"
}

# ----------------------------
# Helper: run one pair
# args:
#   pair_name ref_fa qry_fa ref_short qry_short
# ----------------------------
run_pair() {
    local pair_name="$1"
    local ref_fa="$2"
    local qry_fa="$3"
    local ref_short="$4"
    local qry_short="$5"

    local outdir="$BASE/syri/$pair_name"
    mkdir -p "$outdir"
    cd "$outdir"

    echo "[$(date)] Running $pair_name"

    # 1. PAF with original chromosome-only FASTA
    minimap2 -x asm5 -t 16 "$ref_fa" "$qry_fa" > "${pair_name}.paf"

    # 2. Best hits and reordered query list
    make_besthits "${pair_name}.paf" "${pair_name}_besthits.tsv"
    make_reordered_list "${pair_name}_besthits.tsv" "${pair_name}_qry_reordered.list"

    # Safety check: 28 unique chromosomes in reordered query
    if [ "$(wc -l < "${pair_name}_qry_reordered.list")" -ne 28 ]; then
        echo "ERROR: ${pair_name}_qry_reordered.list does not contain 28 entries"
        exit 1
    fi
    if [ "$(sort -u "${pair_name}_qry_reordered.list" | wc -l)" -ne 28 ]; then
        echo "ERROR: ${pair_name}_qry_reordered.list contains duplicated chromosomes"
        exit 1
    fi

    # 3. Re-extract query in correct order
    samtools faidx "$qry_fa" $(cat "${pair_name}_qry_reordered.list") > "${pair_name}_qry_reordered.fna"
    samtools faidx "${pair_name}_qry_reordered.fna"

    # 4. Rename both ref and query to Chr01..Chr28
    cp "$ref_fa" "${pair_name}_ref_original_order.fna"
    samtools faidx "${pair_name}_ref_original_order.fna"

    rename_chr_pad "${pair_name}_ref_original_order.fna" "${pair_name}_ref_pad.fna"
    rename_chr_pad "${pair_name}_qry_reordered.fna" "${pair_name}_qry_pad.fna"

    # 5. First alignment SAM for SyRI
    minimap2 -a -x asm5 --eqx -t 16 \
        "${pair_name}_ref_pad.fna" \
        "${pair_name}_qry_pad.fna" \
        > "${pair_name}.sam"

    # 6. First SyRI pass
    set +e
    "$SYRI_BIN/syri" \
        -c "${pair_name}.sam" \
        -r "${pair_name}_ref_pad.fna" \
        -q "${pair_name}_qry_pad.fna" \
        -k -F S \
        > "${pair_name}_syri_pass1.log" 2>&1
    pass1_status=$?
    set -e

    FINAL_QRY="${pair_name}_qry_pad.fna"

    # 7. Detect chromosomes with inverted-orientation warning
    grep "high fraction of inverted alignments" "${pair_name}_syri_pass1.log" \
        | sed -E 's/.*Reference chromosome (Chr[0-9]+).*/\1/' \
        | sort -u \
        > "${pair_name}_rc_chromosomes.list" || true

    if [ "$pair_name" = "ATL_vs_PAC" ]; then
        echo "Chr25" >> "${pair_name}_rc_chromosomes.list"
        sort -u "${pair_name}_rc_chromosomes.list" -o "${pair_name}_rc_chromosomes.list"
    fi

    # 8. If SyRI failed and inverted chromosomes are detected, RC-fix query and rerun
    if [ "$pass1_status" -ne 0 ] && [ -s "${pair_name}_rc_chromosomes.list" ]; then
        echo "[$(date)] ${pair_name}: pass1 failed; applying RC fix to query chromosomes:"
        cat "${pair_name}_rc_chromosomes.list"

        make_rc_fixed_query \
            "${pair_name}_qry_pad.fna" \
            "${pair_name}_rc_chromosomes.list" \
            "${pair_name}_qry_pad_rcfix.fna"

        minimap2 -a -x asm5 --eqx -t 16 \
            "${pair_name}_ref_pad.fna" \
            "${pair_name}_qry_pad_rcfix.fna" \
            > "${pair_name}_rcfix.sam"

        "$SYRI_BIN/syri" \
            -c "${pair_name}_rcfix.sam" \
            -r "${pair_name}_ref_pad.fna" \
            -q "${pair_name}_qry_pad_rcfix.fna" \
            -k -F S \
            > "${pair_name}_syri_pass2.log" 2>&1

        FINAL_QRY="${pair_name}_qry_pad_rcfix.fna"

    elif [ "$pass1_status" -ne 0 ]; then
        echo "ERROR: ${pair_name} failed in SyRI pass1 and no RC candidates were detected"
        exit 1
    else
        echo "[$(date)] ${pair_name}: SyRI pass1 completed without fatal error"
    fi

        # 9. plotsr genomes file with custom genome colours
    get_genome_color() {
        case "$1" in
            MED) echo "#FFD93D" ;;
            NEA) echo "#4999B6" ;;
            NP)  echo "#ACACA7" ;;
            *)   echo "#444444" ;;
        esac
    }

    REF_COLOR=$(get_genome_color "$ref_short")
    QRY_COLOR=$(get_genome_color "$qry_short")

    printf "%s\t%s\t%s\n%s\t%s\t%s\n" \
    "$outdir/${pair_name}_ref_pad.fna" "$ref_short" "lc:${REF_COLOR};lw:1.5" \
    "$outdir/$FINAL_QRY" "$qry_short" "lc:${QRY_COLOR};lw:1.5" \
    > genomes.txt

    # Convert all non-syntenic annotations to INV so plotsr draws them in one colour
    awk 'BEGIN{OFS="\t"}
    /^#/ {print; next}
    NF >= 11 && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $7 ~ /^[0-9]+$/ && $8 ~ /^[0-9]+$/ {
        if($11=="SYN" || $11=="SYNAL") {
            $11="SYN";
        } else {
            $11="TRANS";
        }
        print
    }' syri.out > syri_rearr.out

    # 10. plotsr PNG

export MPLCONFIGDIR=$PWD/mplconfig
mkdir -p "$MPLCONFIGDIR"
export MATPLOTLIBRC=$PWD/matplotlibrc
echo "svg.fonttype: none" > "$MATPLOTLIBRC"

    "$SYRI_BIN/plotsr" \
        --sr syri_rearr.out \
        --genomes genomes.txt \
        -o "${pair_name}_plotsr_v2.png" \
        -H 8 -W 5

    # 10b. plotsr SVG with legend text changed to Rearrangements
    "$SYRI_BIN/plotsr" \
        --sr syri_rearr.out \
        --genomes genomes.txt \
        -o "${pair_name}_plotsr_v2.svg" \
        -H 8 -W 5

    # Fix plotsr legend/text and translocation colour in SVG

    sed -i \
        -e 's/Translocation/Rearrangements/g' \
        -e 's/Translocations/Rearrangements/g' \
        -e 's/#9acd32/#FF4500/g' \
        "${pair_name}_plotsr_v2.svg"

    # 11. Ribbon plot
    python "$PLOT_SCRIPT" \
        --syri syri.out \
        --ref_fai "$outdir/${pair_name}_ref_pad.fna.fai" \
        --qry_fai "$outdir/${FINAL_QRY}.fai" \
        --ref_name "$ref_short" \
        --qry_name "$qry_short" \
        --output "${pair_name}_synteny" \
        --min_size 10000 \
        --fig_width 22 \
        --fig_height 7

    echo "[$(date)] Finished $pair_name"
}

# ----------------------------
# Run all three pairs
# IMPORTANT:
# - MED_vs_ATL unchanged
# - MED_vs_PAC unchanged
# - ONLY ATL_vs_PAC uses ATL_28chr_correct.fna as reference
