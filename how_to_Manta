import os
import pandas as pd
import re

# ---------- METADATA NOU ----------
META_G1 = "/home/MBEacherin/yeray/results_manta/sv_metadata/pop_CC_new.txt"
META_ATL_PAC = "/home/MBEacherin/yeray/results_manta/sv_metadata/pop_Cc_new.txt"

OUTDIR = "/home/MBEacherin/yeray/results_manta/sv_metadata"

# ---------- INPUTS (els mateixos) ----------
G1_IN = "/home/MBEacherin/yeray/results_manta/sv_metadata/genoma1.merged_with_samples.tsv"
ATL_IN = "/home/MBEacherin/yeray/results_manta/sv_metadata/genomaATL.merged_with_samples.tsv"
PAC_IN = "/home/MBEacherin/yeray/results_manta/sv_metadata/genomaPAC.merged_with_samples.tsv"


def load_meta(meta_path):
    return pd.read_csv(meta_path, sep="\t")


def normalize_sample(name):
    name = re.sub(r"\.noN$", "", name)
    name = re.sub(r"_mapping_Sc.*$", "", name)
    name = re.sub(r"_mapping.*$", "", name)
    name = re.sub(r"\.sorted.*$", "", name)
    return name


def count_one(infile, tag, meta):
    df = pd.read_csv(infile, sep="\t")

    rows = []
    for _, r in df.iterrows():
        svtype = r["SVTYPE"]
        samples = str(r["SAMPLES"])

        if samples == "NA" or samples.strip() == "":
            continue

        for s in samples.split(","):
            s = normalize_sample(s)
            rows.append({"Sample": s, "SVTYPE": svtype})

    long_df = pd.DataFrame(rows)

    if long_df.empty:
        out = pd.DataFrame(columns=["Sample", "nDEL", "nDUP", "nINV", "nINS", "nSV_total"])
    else:
        tab = (
            long_df.groupby(["Sample", "SVTYPE"])
            .size()
            .reset_index(name="N")
            .pivot(index="Sample", columns="SVTYPE", values="N")
            .fillna(0)
            .reset_index()
        )

        for c in ["DEL", "DUP", "INV", "INS"]:
            if c not in tab.columns:
                tab[c] = 0

        tab["nDEL"] = tab["DEL"].astype(int)
        tab["nDUP"] = tab["DUP"].astype(int)
        tab["nINV"] = tab["INV"].astype(int)
        tab["nINS"] = tab["INS"].astype(int)
        tab["nSV_total"] = tab[["nDEL", "nDUP", "nINV", "nINS"]].sum(axis=1)

        out = tab[["Sample", "nDEL", "nDUP", "nINV", "nINS", "nSV_total"]].copy()

    # merge amb metadata nova
    meta2 = meta.copy()
    meta2["Sample"] = meta2["Sample"].astype(str)

    out = meta2.merge(out, on="Sample", how="left").fillna(0)

    for c in ["nDEL", "nDUP", "nINV", "nINS", "nSV_total"]:
        out[c] = out[c].astype(int)

    # ---------- OUTPUTS NOUS ----------
    out.to_csv(f"{OUTDIR}/{tag}.nSV_by_type_with_metadata_NEW.tsv", sep="\t", index=False)

    summ = (
        out.groupby("Location2")
        .agg(
            N=("Sample", "count"),
            mean_total=("nSV_total", "mean"),
            sd_total=("nSV_total", "std"),
            mean_DEL=("nDEL", "mean"),
            mean_DUP=("nDUP", "mean"),
            mean_INV=("nINV", "mean"),
            mean_INS=("nINS", "mean"),
        )
        .reset_index()
        .rename(columns={"Location2": "Pop"})
    )

    summ.to_csv(f"{OUTDIR}/{tag}.summary_by_Location2_NEW.tsv", sep="\t", index=False)


if __name__ == "__main__":
    os.makedirs(OUTDIR, exist_ok=True)

    meta_g1 = load_meta(META_G1)
    meta_atl_pac = load_meta(META_ATL_PAC)

    count_one(G1_IN, "genoma1", meta_g1)
    count_one(ATL_IN, "genomaATL", meta_atl_pac)
    count_one(PAC_IN, "genomaPAC", meta_atl_pac)

    print("Done. NEW outputs generated.")
