def samples_from_list(list_path):
    samples = []
    with open(list_path) as f:
        for line in f:
            p = line.strip()
            if not p:
                continue
            base = os.path.basename(p)
            base = re.sub(r"\.vcf$", "", base)
            base = re.sub(r"\.PASS\.min50\.noBND$", "", base)
            base = re.sub(r"\.PASS\.manual\.noBND\.min50$", "", base)
            base = re.sub(r"\.diploidSV$", "", base)
            samples.append(base)
    return samples


def parse_vcf_support(vcf_path, samples):
    rows = []
    opener = gzip.open if vcf_path.endswith(".gz") else open

    with opener(vcf_path, "rt", errors="replace") as f:
        for line in f:
            if line.startswith("#"):
                continue

            fields = line.rstrip("\n").split("\t")
            if len(fields) < 8:
                continue

            chrom, pos, vid, ref, alt, qual, filt, info = fields[:8]

            infod = {}
            for item in info.split(";"):
                if "=" in item:
                    k, v = item.split("=", 1)
                    infod[k] = v
                else:
                    infod[item] = True

            supp_vec = infod.get("SUPP_VEC")
            supp = infod.get("SUPP")

            if supp_vec is None:
                continue

            try:
                supp_i = int(supp) if supp is not None else None
            except Exception:
                supp_i = None

            if len(supp_vec) != len(samples):
                present = None
            else:
                present = [samples[i] for i, c in enumerate(supp_vec) if c == "1"]

            rows.append({
                "CHROM": chrom,
                "POS": int(pos),
                "ID": vid,
                "SVTYPE": infod.get("SVTYPE"),
                "SVLEN": infod.get("SVLEN"),
                "SUPP": supp_i,
                "SUPP_VEC": supp_vec,
                "SAMPLES": ",".join(present) if present is not None else "NA"
            })

    return pd.DataFrame(rows)


def classify_by_group(df, meta, group_col, group_levels):
    sample2group = dict(zip(meta["Sample"], meta[group_col]))

    def groups_present(sample_list):
        gs = set()
        for s in sample_list:
            g = sample2group.get(s)
            if g is not None:
                gs.add(g)
        return gs

    labels = []
    for s in df["SAMPLES"].fillna("NA"):
        if s == "NA" or s == "":
            labels.append("UNKNOWN")
            continue

        sample_list = s.split(",")
        gs = groups_present(sample_list)
        gs_ord = [g for g in group_levels if g in gs]

        if len(gs_ord) == 0:
            labels.append("UNKNOWN")
        elif len(gs_ord) == 1:
            labels.append(gs_ord[0])
        else:
            labels.append("+".join(gs_ord))

    out = df.copy()
    out[f"{group_col}_class"] = labels
    return out


def summarize_classes(df, class_col, out_path):
    summ = df.groupby([class_col, "SVTYPE"]).size().reset_index(name="N")
    summ.to_csv(out_path, sep="\t", index=False)


def run_one(vcf, vlist, meta_path, tag, outdir):
    meta = pd.read_csv(meta_path, sep="\t")
    samples = samples_from_list(vlist)

    def normalize(name):
        name = re.sub(r"\.noN$", "", name)
        name = re.sub(r"_mapping_Sc.*$", "", name)
        name = re.sub(r"_mapping.*$", "", name)
        name = re.sub(r"\.sorted.*$", "", name)
        return name

    samples_norm = [normalize(s) for s in samples]

