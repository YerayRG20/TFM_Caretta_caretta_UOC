#!/bin/bash
#SBATCH --job-name=filter_noN
#SBATCH --cpus-per-task=4
#SBATCH --mem=12G
#SBATCH --time=08:00:00
#SBATCH --output=/home/MBEacherin/yeray/sortedbam/sortedbam_noN/logs/filter_noN_array_1.out
#SBATCH --error=/home/MBEacherin/yeray/sortedbam/sortedbam_noN/logs/filter_noN_array_1.err
#SBATCH --array=1-14

set -euo pipefail

# ====== CONFIGURA AIXÒ ======
LIST="/home/MBEacherin/yeray/sortedbam/bamlist_genoma1.txt"
OUTDIR="/home/MBEacherin/yeray/sortedbam/sortedbam_noN"
# ============================

echo "[INFO] SLURM_JOB_ID=${SLURM_JOB_ID} TASK_ID=${SLURM_ARRAY_TASK_ID}"
echo "[INFO] Using list: $LIST"
echo "[INFO] Writing to: $OUTDIR"

# Validacions abans de res:
if [[ ! -s "$LIST" ]]; then
  echo "[ERROR] BAM list not found or empty: $LIST"
  exit 10
fi

BAM=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$LIST" || true)

if [[ -z "${BAM}" ]]; then
  echo "[ERROR] No BAM found for array index ${SLURM_ARRAY_TASK_ID} in $LIST"
  exit 11
fi
if [[ ! -s "$BAM" ]]; then
  echo "[ERROR] BAM path does not exist: $BAM"
  exit 12
fi

SAMPLE=$(basename "$BAM" .bam)
OUTBAM="${OUTDIR}/${SAMPLE}.noN.bam"

echo "[INFO] Processing: $BAM"
echo "[INFO] Output BAM:  $OUTBAM"

# Si ja existeix BAM i índex, salta
if [[ -s "$OUTBAM" && -s "${OUTBAM}.bai" ]]; then
  echo "[INFO] Output already exists. Skipping."
  exit 0
fi

# Check BAM integrity
samtools quickcheck -v "$BAM" || { echo "[ERROR] BAM failed quickcheck"; exit 20; }

# Filtra CIGAR amb N
samtools view -h "$BAM" \
| awk 'BEGIN{OFS="\t"} /^@/ {print; next} $6 !~ /N/ {print}' \
| samtools view -@ 3 -b -o "$OUTBAM"

samtools index -@ 3 "$OUTBAM"

# Sanity
if samtools view "$OUTBAM" | awk '$6 ~ /N/' | head -n 1 | grep -q .; then
  echo "[ERROR] Still found CIGAR N after filtering."
  exit 21
fi

echo "[OK] Done filtering $SAMPLE"
