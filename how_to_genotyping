    flush.console()

    df_chr <- plot_pop %>% filter(chromosome == chr_i)
    if (nrow(df_chr) == 0) next

    w_chr <- unique(df_chr$window)
    s_chr <- unique(df_chr$step)

    p1 <- ggplot(df_chr, aes(x = POS_mean, y = value, colour = Location2_plot, group = Sample)) +
