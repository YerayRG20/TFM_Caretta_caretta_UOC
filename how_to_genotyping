# =========================
# FUNCTION
# =========================

Detect_Inversions <- function(df, window, step) {
  chromosome <- df[, 1]
  data_cols <- df[, -1]
  total <- nrow(df)

  if (total < window) return(NULL)

  spots <- seq(from = 1, to = (total - window + 1), by = step)

  result <- data.frame(
    chromosome = character(length(spots)),
    stringsAsFactors = FALSE
  )

  for (col in names(data_cols)) {
    result[[paste0(col, "_mean")]] <- numeric(length(spots))
  }

  for (i in seq_along(spots)) {
    idx1 <- spots[i]
    idx2 <- spots[i] + window - 1

    window_chromosome <- chromosome[idx1:idx2]

    if (length(unique(window_chromosome)) == 1) {
      result$chromosome[i] <- unique(window_chromosome)

      for (col in names(data_cols)) {
        window_data <- data_cols[[col]][idx1:idx2]
        if (all(is.na(window_data))) {
          result[[paste0(col, "_mean")]][i] <- NA
        } else {
          result[[paste0(col, "_mean")]][i] <- mean(window_data, na.rm = TRUE)
        }
      }
    }
  }

  result <- result %>%
    filter(chromosome != "", !is.na(POS_mean))

  return(result)
}

# =========================
# ANALYSIS FUNCTION
# =========================

run_scheme <- function(chr_groups, scheme_name) {

  cat("\n=============================\n")
  cat("Running scheme:", scheme_name, "\n")
  cat("=============================\n\n")

  results_list <- list()

  for (i in seq_len(nrow(chr_groups))) {
    chr_i <- chr_groups$chromosome[i]
    window_i <- chr_groups$window[i]
    step_i <- chr_groups$step[i]

    cat("Running", chr_i, "with window =", window_i, "step =", step_i, "\n")
    flush.console()

    TS_chr <- TS %>% filter(CHR == chr_i)
    res_chr <- Detect_Inversions(TS_chr, window = window_i, step = step_i)

    if (!is.null(res_chr) && nrow(res_chr) > 0) {
      res_chr$window <- window_i
      res_chr$step <- step_i
      res_chr$scheme <- scheme_name
      results_list[[chr_i]] <- res_chr
    }
  }

  newTS <- bind_rows(results_list)

  write.table(
    newTS,
    file = paste0(scheme_name, "_windows_inversiones_all_chr.txt"),
    sep = "\t", row.names = FALSE, quote = FALSE
  )

  newTS_long <- newTS %>%
    melt(id.vars = c("chromosome", "POS_mean", "window", "step", "scheme")) %>%
    mutate(Sample = gsub("_mean", "", variable)) %>%
    left_join(metadata, by = c("Sample" = "Sample"))

  newTS_long$Chr <- factor(newTS_long$chromosome, levels = orden_chr)
  newTS_long <- newTS_long[order(newTS_long$Chr, newTS_long$POS_mean), ]

  newTS_clean <- newTS_long %>%
    filter(
      !is.na(value),
      !is.na(POS_mean),
      !is.na(Chr),
      !is.na(chromosome)
    )

  write.table(
    newTS_clean,
    file = paste0(scheme_name, "_windows_inversiones_all_chr_with_metadata.txt"),
    sep = "\t", row.names = FALSE, quote = FALSE
  )

  newTS_clean <- newTS_clean %>%
    mutate(
