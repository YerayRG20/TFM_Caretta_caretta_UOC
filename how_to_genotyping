        Location1 == "Libya" ~ "LI",
        Location1 == "Boavista" ~ "BOA",
        Location1 == "Florida" ~ "FL",
        Location1 == "QuintanaRoo" ~ "MEX-ATL",
        Location1 == "MexicoPacific" ~ "MEX-PAC",
        TRUE ~ as.character(Location1)
      ),
      Location2_plot = as.character(Location2)
    )

  plot_pop <- newTS_clean %>%
    filter(!is.na(Location2_plot), !is.na(Sample))

  plot_loc1 <- newTS_clean %>%
    filter(!is.na(Location1_plot), !is.na(Sample))

  # =========================
  # PDF Location2
